# =============================================================================
# CloudLinkedIn Agent - Environment Variables
# Copy this file to .env for local development. NEVER commit the real .env file.
# In production (GitHub Actions) these are provided via repository/environment
# secrets - see README.md "GitHub Setup" section.
# =============================================================================

NODE_ENV=development

# --- Gemini AI -----------------------------------------------------------
# Get a key at https://aistudio.google.com/app/apikey (free tier available)
GEMINI_API_KEY=
# Model name is configurable so it can change without touching source code.
GEMINI_MODEL=gemini-2.5-flash
# Used to generate the photo attached to each LinkedIn post.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- LinkedIn OAuth / Posts API ------------------------------------------
# Created in the LinkedIn Developer Portal: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match a redirect URL registered on the LinkedIn app (used only
# by the one-time local OAuth helper: `npm run linkedin:auth`).
LINKEDIN_REDIRECT_URI=http://localhost:8181/callback
# Obtained once via `npm run linkedin:auth`, then stored as a GitHub secret.
LINKEDIN_ACCESS_TOKEN=
# LinkedIn REST API version header, format YYYYMM. Keep this current -
# see https://learn.microsoft.com/linkedin/marketing/community-management/shares/posts-api
LINKEDIN_API_VERSION=202609

# --- Scheduling / behavior -------------------------------------------------
POST_TIMEZONE=America/Toronto

# When true, the pipeline generates + validates a post but does NOT call the
# LinkedIn API. Always keep this true until you have verified the output.
DRY_RUN=true

# When true, LinkedIn calls are simulated locally (no network call, no real
# token required). Useful for development independent of DRY_RUN.
MOCK_LINKEDIN=false

# When true, Gemini calls are simulated locally (no network call, no API key
# required, no quota consumed). Useful for development and CI tests.
MOCK_GEMINI=false

POSTS_PER_DAY=1
MAX_POSTS_PER_DAY=1
MAX_AI_REQUESTS_PER_RUN=3
